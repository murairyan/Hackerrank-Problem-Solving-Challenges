/*
 * Complete the 'migratoryBirds' function below.
 *
 * The function is expected to return an INTEGER.
 * The function accepts INTEGER_ARRAY arr as parameter.
 */

int migratoryBirds(vector<int> arr) {
    // Create an int array that will contain the 5 different bird types
    // Initialize all counts to be set to 0
    int counts[5] = {0};
    
    // This loop will parse through the array and take account
    // for the amount of each type
    // int bird_type : arr the variable bird_type will be assigned the value of the next integer element in the array
    for(int bird_type : arr) {
        // int variable "counts" was initialized at 1; therefore, the "-1" would deduct the first index back to 0. 
        counts[bird_type -1]++;
    }
    
    // The for loop will iterate through the amount of each number and compare which has the highest value and then return it 
    int maxIndex = 0;
    for(int i = 1; i < 5; i++) {
        if (counts[i] > counts[maxIndex]) {
            maxIndex = i;
        }
    }
    
    return maxIndex + 1;
}
